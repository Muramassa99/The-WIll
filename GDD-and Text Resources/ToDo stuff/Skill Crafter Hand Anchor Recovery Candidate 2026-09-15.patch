+class AnchorFixturePresenter:
+	extends "res://runtime/combat/combat_animation_station_preview_presenter.gd"
+	var fixture_dominant_slot: StringName = &"hand_right"
+
+	func _resolve_preview_dominant_slot_id() -> StringName:
