+class AnchorFixtureRig:
+	extends "res://runtime/player/player_humanoid_rig.gd"
+	var fixture_right_anchor: Node3D
+	var fixture_left_anchor: Node3D
+
+	func get_right_hand_item_anchor() -> Node3D:
