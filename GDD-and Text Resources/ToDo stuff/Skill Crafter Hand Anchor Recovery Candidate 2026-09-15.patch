+	var registry = state["registry"]
+	var expected_chain: Array = [expected_anchor_id, expected_wrist_id, OriginScript.ORIGIN_RL_BONE_ROOT]
+	_check(state.get("anchor_origin_id") == expected_anchor_id and state.get("origin_chain_ids") == expected_chain, "%s named anchor/wrist/machine chain" % label)
+	_check(state.get("transform_world_origin_id") == OriginScript.ORIGIN_RL_BONE_ROOT, "%s declared presentation origin" % label)
+	_check(record.parent_origin_id == expected_wrist_id and record.transform_to_parent.is_equal_approx(anchor_before), "%s authored anchor edge" % label)
+	_check(record.resolve_phase == OriginScript.PHASE_EDITOR_PREVIEW and record.is_dynamic, "%s anchor phase/lifetime" % label)
+	_check(registry.get_origin(expected_wrist_id).resolve_phase == OriginScript.PHASE_EDITOR_PREVIEW, "%s wrist intermediate phase" % label)
+	_check(bool(registry.validate_origin_chain(expected_anchor_id).get("ok", false)), "%s valid registry chain" % label)
+	var registered_world: Transform3D = state["machine_to_world"] * registry.resolve_transform_to_machine(expected_anchor_id)
+	_check(registered_world.is_equal_approx(expected_world) and (state["transform_world"] as Transform3D).is_equal_approx(expected_world), "%s full affine world frame" % label)
+	var expected_machine: Transform3D = fixture.get_bone_global_pose(1).affine_inverse() * fixture.get_bone_global_pose(hand_index) * anchor_before
+	_check(record.resolved_transform_to_machine.is_equal_approx(expected_machine), "%s machine-relative basis/position/scale" % label)
+	var wrist: Dictionary = rig.capture_authoring_wrist_origin(slot)
+	_check(bool(wrist.get("available", false)) and wrist["origin_record"].resolve_phase == OriginScript.PHASE_POST_FINAL_POSE, "%s public wrist phase preserved" % label)
+	# Real production anatomy calculates C; the test only checks the frame bridge.
+	var contact_world: Vector3 = rig._resolve_anatomically_seated_hand_grip_center_world(slot, rig._resolve_hand_index_pinky_contact_center_world(slot))
+	var offset_state: Dictionary = rig.resolve_hand_grip_alignment_offset_state(slot)
+	var offset: Vector3 = offset_state.get("hand_alignment_offset_local", Vector3.INF)
+	_check(offset.is_finite() and contact_world.is_finite(), "%s finite contact/offset" % label)
+	_check(offset_state.get("hand_alignment_offset_origin_id") == OriginScript.ORIGIN_HAND_GRIP_ALIGNMENT, "%s contact origin distinct from wrist" % label)
+	_check(bool(offset_state.get("valid", false)) and offset_state.has("registry") and offset_state.has("machine_to_world"), "%s registered contact packet" % label)
+	if bool(offset_state.get("valid", false)) and offset_state.has("registry") and offset_state.has("machine_to_world"):
+		var offset_registry = offset_state["registry"]
+		var offset_record: Resource = offset_registry.get_origin(OriginScript.ORIGIN_HAND_GRIP_ALIGNMENT)
+		_check(offset_record.parent_origin_id == expected_anchor_id and offset_record.transform_to_parent.is_equal_approx(Transform3D.IDENTITY), "%s contact coordinate frame parent" % label)
+		var offset_to_world: Transform3D = offset_state["machine_to_world"] * offset_registry.resolve_transform_to_machine(OriginScript.ORIGIN_HAND_GRIP_ALIGNMENT)
+		_check(bool(offset_registry.validate_origin_chain(OriginScript.ORIGIN_HAND_GRIP_ALIGNMENT).get("ok", false)) and (offset_to_world * offset).distance_to(contact_world) <= POSITION_EPSILON, "%s registry reconstructs anatomical contact" % label)
+	_check((expected_world * offset).distance_to(contact_world) <= POSITION_EPSILON, "%s current anchor reconstructs contact from local offset" % label)
+	_check(rig.resolve_hand_grip_alignment_world_position(slot).distance_to(contact_world) <= POSITION_EPSILON, "%s world contact meaning preserved" % label)
+	_check_presenter_consumers(rig, fixture, slot, expected_world, contact_world, label)
+	if stale:
+		var legacy_offset: Vector3 = anchor.to_local(contact_world)
+		_check((expected_world * legacy_offset).distance_to(contact_world) > POSITION_EPSILON, "%s detects old mixed-frame offset" % label)
+		_check(anchor.to_global(offset).distance_to(contact_world) > POSITION_EPSILON, "%s detects stale presenter offset application" % label)
+	# Non-authoring behavior retains the existing attachment-based conversion.
+	rig.authoring_preview_mode_enabled = false
+	_check(rig.resolve_hand_grip_alignment_offset_local(slot).distance_to(anchor.to_local(contact_world)) <= POSITION_EPSILON, "%s non-authoring local path unchanged" % label)
+	rig.authoring_preview_mode_enabled = true
+	for bone_index: int in range(fixture.get_bone_count()):
+		_check(before[bone_index].is_equal_approx(fixture.get_bone_pose(bone_index)), "%s no bone write %d" % [label, bone_index])
+	_check(anchor.transform.is_equal_approx(anchor_before) and attachment.transform.is_equal_approx(attachment_before), "%s no anchor/attachment write" % label)
+
+func _check_presenter_consumers(rig: AnchorFixtureRig, fixture: Skeleton3D, slot: StringName, anchor_world: Transform3D, contact_world: Vector3, label: String) -> void:
+	var presenter := AnchorFixturePresenter.new()
+	presenter.fixture_dominant_slot = slot
+	var target_world: Vector3 = presenter._resolve_preview_hand_grip_target_world(rig, slot)
+	_check(target_world.is_finite() and target_world.distance_to(contact_world) <= POSITION_EPSILON, "%s presenter resolves registered anatomical contact" % label)
+	var held := Node3D.new()
+	fixture.get_parent().add_child(held)
+	held.transform = Transform3D(Basis(Vector3.FORWARD, -0.37), Vector3(-1.2, 0.7, 0.4))
+	var grip_local_weapon_root := Vector3(0.014, -0.021, 0.16)
+	var mount_local_transform := Transform3D(Basis.from_euler(Vector3(-0.2, 0.31, 0.14)), Vector3(0.027, 0.041, -0.019))
+	held.set_meta(presenter.PREVIEW_PRIMARY_GRIP_SEAT_LOCAL_META, grip_local_weapon_root)
+	held.set_meta(presenter.PREVIEW_PRIMARY_GRIP_SEAT_ORIGIN_META, OriginScript.ORIGIN_WEAPON_ROOT)
+	held.set_meta(presenter.PREVIEW_HAND_MOUNT_LOCAL_TRANSFORM_META, mount_local_transform)
+	held.set_meta(presenter.PREVIEW_HAND_MOUNT_LOCAL_TRANSFORM_ORIGIN_META, OriginScript.ORIGIN_HAND_GRIP_ALIGNMENT)
+	var held_before: Transform3D = held.transform
+	var held_world_before: Transform3D = held.global_transform
+	var mounted: Transform3D = presenter._resolve_preview_hand_mounted_transform(rig, held, grip_local_weapon_root, mount_local_transform)
+	var expected_basis: Basis = (anchor_world.basis * mount_local_transform.basis).orthonormalized()
+	_check(mounted.is_finite(), "%s presenter mount is finite" % label)
+	_check(mounted.basis.is_equal_approx(expected_basis), "%s presenter mount uses current anchor basis" % label)
+	_check((mounted * grip_local_weapon_root).distance_to(contact_world) <= POSITION_EPSILON, "%s mounted WeaponRoot grip reaches anatomical contact" % label)
+	_check(held.transform.is_equal_approx(held_before) and held.global_transform.is_equal_approx(held_world_before), "%s presenter mount reader leaves held item untouched" % label)
+	held.free()
+
+func _check_invalid_anchor(rig: AnchorFixtureRig, slot: StringName, anchor: Node3D, attachment: BoneAttachment3D) -> void:
+	if slot == &"hand_right":
+		rig.fixture_right_anchor = null
+	else:
+		rig.fixture_left_anchor = null
+	_check(not bool(rig.resolve_authoring_hand_item_anchor_world_transform_state(slot).get("valid", false)), "%s missing anchor rejected" % slot)
+	var unavailable_offset: Dictionary = rig.resolve_hand_grip_alignment_offset_state(slot)
+	_check(not bool(unavailable_offset.get("valid", true)), "%s missing anchor invalidates offset packet" % slot)
+	var presenter := AnchorFixturePresenter.new()
+	presenter.fixture_dominant_slot = slot
+	var held := Node3D.new()
+	attachment.get_parent().add_child(held)
+	held.transform = Transform3D(Basis(Vector3.RIGHT, 0.24), Vector3(0.4, -0.2, 0.7))
+	var grip_local_weapon_root := Vector3(0.014, -0.021, 0.16)
+	held.set_meta("weapon_tip_local", Vector3(0.01, 0.02, 0.51))
+	held.set_meta("weapon_tip_origin_id", OriginScript.ORIGIN_WEAPON_ROOT)
+	held.set_meta("primary_grip_contact_local", grip_local_weapon_root)
+	held.set_meta("primary_grip_contact_origin_id", OriginScript.ORIGIN_WEAPON_ROOT)
+	held.set_meta(presenter.PREVIEW_HAND_MOUNT_LOCAL_TRANSFORM_META, held.transform)
+	held.set_meta(presenter.PREVIEW_HAND_MOUNT_LOCAL_TRANSFORM_ORIGIN_META, OriginScript.ORIGIN_HAND_GRIP_ALIGNMENT)
+	var held_before: Transform3D = held.transform
+	var held_world_before: Transform3D = held.global_transform
+	var mounted: Transform3D = presenter._resolve_preview_hand_mounted_transform(rig, held, grip_local_weapon_root, held_before)
+	_check(mounted.is_finite() and mounted.is_equal_approx(held_world_before), "%s unavailable mount returns unchanged finite held frame" % slot)
+	var style_state: Dictionary = presenter.equipped_item_presenter.resolve_held_item_grip_style_state(held, rig, slot, &"grip_normal")
+	_check(style_state.is_empty(), "%s unavailable alignment rejects equipped grip-style candidate" % slot)
+	_check(held.transform.is_equal_approx(held_before) and held.global_transform.is_equal_approx(held_world_before), "%s invalid-frame consumers do not write held transform" % slot)
+	held.free()
+	if slot == &"hand_right":
+		rig.fixture_right_anchor = anchor
+	else:
+		rig.fixture_left_anchor = anchor
+	var previous_transform: Transform3D = anchor.transform
+	anchor.transform = Transform3D(Basis.from_scale(Vector3(0.0, 1.0, 1.0)), anchor.position)
+	_check(not bool(rig.resolve_authoring_hand_item_anchor_world_transform_state(slot).get("valid", false)), "%s singular anchor rejected" % slot)
+	anchor.transform = previous_transform
+	var previous_bone_name: String = attachment.bone_name
+	attachment.bone_name = "RL_BoneRoot"
+	_check(not bool(rig.resolve_authoring_hand_item_anchor_world_transform_state(slot).get("valid", false)), "%s wrong attachment bone rejected" % slot)
+	attachment.bone_name = previous_bone_name
+
+func _check_invalid_bones(rig: AnchorFixtureRig, fixture: Skeleton3D) -> void:
+	_check(not bool(rig.resolve_authoring_hand_item_anchor_world_transform_state(&"invalid_slot").get("valid", false)), "unknown slot rejected")
+	for slot: StringName in [&"hand_right", &"hand_left"]:
+		var hand_index: int = 3 if slot == &"hand_right" else 4
+		var previous_name: String = fixture.get_bone_name(hand_index)
+		fixture.set_bone_name(hand_index, "MissingHand")
+		_check(not bool(rig.resolve_authoring_hand_item_anchor_world_transform_state(slot).get("valid", false)), "%s missing Hand rejected" % slot)
+		fixture.set_bone_name(hand_index, previous_name)
+		fixture.set_bone_parent(hand_index, 0)
+		_check(not bool(rig.resolve_authoring_hand_item_anchor_world_transform_state(slot).get("valid", false)), "%s Hand outside machine ancestry rejected" % slot)
+		fixture.set_bone_parent(hand_index, 2)
+	fixture.set_bone_name(1, "MissingMachineRoot")
+	_check(not bool(rig.resolve_authoring_hand_item_anchor_world_transform_state(&"hand_right").get("valid", false)), "missing machine root rejected")
+	fixture.set_bone_name(1, "RL_BoneRoot")
