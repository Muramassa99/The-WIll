+	# Only anchor lookup is overridden; all coordinate/contact readers are real.
+	var rig := AnchorFixtureRig.new()
+	rig.skeleton = fixture
+	rig.authoring_preview_mode_enabled = true
+	for slot: StringName in [&"hand_right", &"hand_left"]:
+		var hand_index: int = 3 if slot == &"hand_right" else 4
+		var attachment := BoneAttachment3D.new()
+		fixture.add_child(attachment)
+		attachment.bone_name = bone_names[hand_index]
+		attachment.override_pose = false
+		var anchor := Node3D.new()
+		attachment.add_child(anchor)
+		anchor.transform = Transform3D(
+			Basis.from_euler(Vector3(0.12, 0.9 if slot == &"hand_right" else -0.7, -0.16)),
+			Vector3(-0.0025, 0.0969, 0.0190)
