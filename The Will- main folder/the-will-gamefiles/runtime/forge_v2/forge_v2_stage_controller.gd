		local_contact_direction
	)

func extend_material_body_path(
	local_position: Vector3,
	force_endpoint: bool = false,
	local_surface_normal: Vector3 = Vector3.FORWARD,
	local_contact_direction: Vector3 = Vector3.ZERO
) -> bool:
	return extend_material_body_path_samples(
		PackedVector3Array([local_position]),
		PackedVector3Array([local_surface_normal]),
		force_endpoint,
		PackedVector3Array([local_contact_direction])
	) > 0

func extend_material_body_path_samples(
	local_positions: PackedVector3Array,
	local_surface_normals: PackedVector3Array = PackedVector3Array(),
	force_final_endpoint: bool = false,
	local_contact_directions: PackedVector3Array = PackedVector3Array()
) -> int:
	if local_positions.is_empty():
		return 0
	if active_placement_body_id == StringName():
		var first_surface_normal := Vector3.FORWARD
		var first_contact_direction := Vector3.ZERO
		if not local_surface_normals.is_empty():
			first_surface_normal = local_surface_normals[0]
		if not local_contact_directions.is_empty():
			first_contact_direction = local_contact_directions[0]
		begin_material_body_path(
			local_positions[0],
			first_surface_normal,
			first_contact_direction
		)
		if active_placement_body_id == StringName():
			return 0
		if local_positions.size() == 1:
			return 1
		var remaining_positions := local_positions.slice(1)
		var remaining_normals := PackedVector3Array()
		var remaining_contact_directions := PackedVector3Array()
		if local_surface_normals.size() > 1:
			remaining_normals = local_surface_normals.slice(1)
		if local_contact_directions.size() > 1:
			remaining_contact_directions = local_contact_directions.slice(1)
		return 1 + extend_material_body_path_samples(
			remaining_positions,
			remaining_normals,
			force_final_endpoint,
			remaining_contact_directions
		)
	var state: Resource = ensure_authoring_state(default_project_name)
	var sample_spacing: float = ensure_workspace_contract().resolve_stroke_sample_spacing(
		_get_active_deposition_sample_radius_meters()
	)
	var changed_sample_count := int(state.call(
		"append_points_to_material_body",
		active_placement_body_id,
		local_positions,
		local_surface_normals,
		sample_spacing,
		force_final_endpoint,
		local_contact_directions
	))
	placement_cursor_local_position = local_positions[local_positions.size() - 1]
	placement_cursor_valid = true
	if changed_sample_count > 0:
		_emit_material_body_preview_changed()
	_emit_placement_cursor_changed()
	return changed_sample_count

func finish_placement_stroke(
	local_position: Vector3 = Vector3.ZERO,
	has_final_position: bool = false,
	local_surface_normal: Vector3 = Vector3.FORWARD,
	local_contact_direction: Vector3 = Vector3.ZERO
) -> bool:
	return finish_material_body_path(
		local_position,
		has_final_position,
		local_surface_normal,
		local_contact_direction
	)

func finish_material_body_path(
	local_position: Vector3 = Vector3.ZERO,
	has_final_position: bool = false,
	local_surface_normal: Vector3 = Vector3.FORWARD,
	local_contact_direction: Vector3 = Vector3.ZERO
) -> bool:
	var had_active_body := active_placement_body_id != StringName()
	var completed_body_id := active_placement_body_id
	var changed := false
	var committed := false
	var commit_ready := false
	var removed := false
	var deferred_commit := false
	var state: Resource = null
	if had_active_body and has_final_position:
		state = ensure_authoring_state(default_project_name)
		var sample_spacing: float = ensure_workspace_contract().resolve_stroke_sample_spacing(
			_get_active_deposition_sample_radius_meters()
		)
		changed = bool(state.call(
			"append_point_to_material_body",
			active_placement_body_id,
			local_position,
			sample_spacing,
			true,
			local_surface_normal,
			local_contact_direction
		))
		placement_cursor_local_position = local_position
		placement_cursor_valid = true
	active_placement_body_id = StringName()
	if had_active_body:
		if state == null:
			state = ensure_authoring_state(default_project_name)
		commit_ready = true
		if state.has_method("is_material_body_commit_ready"):
			commit_ready = bool(state.call(
				"is_material_body_commit_ready",
				completed_body_id
			))
		# Reserve the user action at gesture completion, before any synchronous
		# or deferred structural commit can reorder it behind later edits.
		if commit_ready:
			_record_pending_material_body_action(state, completed_body_id)
		if (
			commit_ready
			and state.has_method("commit_material_body_as_layer")
		):
			if not _deferred_material_body_commit_queue.is_empty():
				deferred_commit = _enqueue_deferred_material_body_commit(
					state,
					completed_body_id
				)
			else:
				committed = (
					state.call(
						"commit_material_body_as_layer",
						completed_body_id
					) != null
				)
				if (
					not committed
					and state.has_method(
						"has_pending_bounded_history_promotion"
					)
					and bool(state.call(
						"has_pending_bounded_history_promotion"
					))
				):
					deferred_commit = _enqueue_deferred_material_body_commit(
						state,
						completed_body_id
					)
		elif (
			not commit_ready
			and state.has_method("remove_material_body")
		):
			removed = bool(state.call(
				"remove_material_body",
				completed_body_id
			))
			changed = removed or changed
	last_material_body_finish_result = {
		"status": (
			&"committed"
			if committed
			else &"commit_deferred"
			if deferred_commit
			else &"commit_rejected"
			if had_active_body and commit_ready
			else &"discarded_not_ready"
			if had_active_body and removed
			else &"no_active_body"
		),
		"body_id": completed_body_id,
		"had_active_body": had_active_body,
		"commit_ready": commit_ready,
		"committed": committed,
		"deferred": deferred_commit,
		"removed": removed,
		"pending": (
			had_active_body
			and commit_ready
			and not committed
		),
	}
	if committed:
		_finalize_latest_committed_layer_action(state, completed_body_id)
	elif removed:
		_material_action_context_by_body_id.erase(completed_body_id)
	if changed or had_active_body or committed:
		_emit_state_changed()
	_emit_placement_cursor_changed()
	return changed or had_active_body or committed


func _enqueue_deferred_material_body_commit(
	authoring_state: Resource,
	body_id: StringName,
	prepend: bool = false
) -> bool:
	if (
		authoring_state == null
		or body_id == StringName()
		or not is_inside_tree()
	):
		return false
	var state_instance_id := int(authoring_state.get_instance_id())
	if (
		_deferred_material_body_commit_state_instance_id != 0
		and _deferred_material_body_commit_state_instance_id
		!= state_instance_id
	):
		_clear_deferred_material_body_commit_queue()
	_deferred_material_body_commit_state_instance_id = state_instance_id
	var existing_index := _deferred_material_body_commit_queue.find(body_id)
	if existing_index >= 0 and prepend:
		_deferred_material_body_commit_queue.remove_at(existing_index)
	if not _deferred_material_body_commit_queue.has(body_id):
		if prepend:
			_deferred_material_body_commit_queue.push_front(body_id)
		else:
			_deferred_material_body_commit_queue.append(body_id)
	if not _deferred_material_body_commit_drain_running:
		_deferred_material_body_commit_drain_running = true
		call_deferred(
			"_drain_deferred_material_body_commits",
			_deferred_material_body_commit_generation
		)
	return true


func _drain_deferred_material_body_commits(drain_generation: int) -> void:
	while not _deferred_material_body_commit_queue.is_empty():
		if drain_generation != _deferred_material_body_commit_generation:
			return
		# Keep queued bodies in the presenter's pending-overlay lane while the
		# user is actively drawing the next stroke.  Static publication is
		# intentionally paused for an active placement body.
		if active_placement_body_id != StringName():
			await get_tree().process_frame
			continue
		var state := active_authoring_state
		if (
			state == null
			or not is_instance_valid(state)
			or int(state.get_instance_id())
			!= _deferred_material_body_commit_state_instance_id
		):
			_clear_deferred_material_body_commit_queue()
			return
		if (
			state.has_method("has_pending_bounded_history_promotion")
			and bool(state.call("has_pending_bounded_history_promotion"))
		):
			await get_tree().process_frame
			continue
		var body_id := _deferred_material_body_commit_queue[0]
		var commit_ready := (
			bool(state.call("is_material_body_commit_ready", body_id))
			if state.has_method("is_material_body_commit_ready")
			else false
		)
		var committed_layer: Resource = null
		if commit_ready and state.has_method("commit_material_body_as_layer"):
			committed_layer = state.call(
				"commit_material_body_as_layer",
				body_id
			) as Resource
		if (
			committed_layer == null
			and state.has_method("has_pending_bounded_history_promotion")
			and bool(state.call("has_pending_bounded_history_promotion"))
		):
			await get_tree().process_frame
			continue
		_deferred_material_body_commit_queue.pop_front()
		if StringName(last_material_body_finish_result.get(
			"body_id",
			StringName()
		)) == body_id:
			last_material_body_finish_result["status"] = (
				&"committed"
				if committed_layer != null
				else &"commit_rejected"
			)
			last_material_body_finish_result["committed"] = (
				committed_layer != null
			)
			last_material_body_finish_result["deferred"] = false
			last_material_body_finish_result["pending"] = (
				committed_layer == null
			)
		if committed_layer != null:
			_finalize_committed_layer_action(committed_layer, body_id)
		else:
			_record_pending_material_body_action(state, body_id)
		_emit_state_changed()
		await get_tree().process_frame
	if drain_generation == _deferred_material_body_commit_generation:
		_deferred_material_body_commit_drain_running = false
		_deferred_material_body_commit_state_instance_id = 0


func _clear_deferred_material_body_commit_queue() -> void:
	_deferred_material_body_commit_generation += 1
	_deferred_material_body_commit_queue.clear()
	_deferred_material_body_commit_state_instance_id = 0
	_deferred_material_body_commit_drain_running = false


