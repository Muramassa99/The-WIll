func _stamp_saved_wip_id_into_v2_state(wip_library, saved_wip: CraftedItemWIP) -> void:
	if wip_library == null or saved_wip == null or saved_wip.wip_id == StringName():
		return
	var changed := false
	if saved_wip.forge_v2_authoring_state != null and StringName(saved_wip.forge_v2_authoring_state.get("source_wip_id")) != saved_wip.wip_id:
		saved_wip.forge_v2_authoring_state.set("source_wip_id", saved_wip.wip_id)
		changed = true
	if wip_library.has_method("get_saved_wip"):
		var stored_wip: CraftedItemWIP = wip_library.call("get_saved_wip", saved_wip.wip_id) as CraftedItemWIP
		if stored_wip != null and stored_wip.forge_v2_authoring_state != null and StringName(stored_wip.forge_v2_authoring_state.get("source_wip_id")) != saved_wip.wip_id:
			stored_wip.forge_v2_authoring_state.set("source_wip_id", saved_wip.wip_id)
			changed = true
	if changed and wip_library.has_method("persist"):
		wip_library.call("persist")

func _emit_state_changed() -> void:
	var emitted_state := active_authoring_state
	var pending_transition: Dictionary = {}
	var had_pending_promotion := (
		emitted_state != null
		and emitted_state.has_method(
			"has_pending_bounded_history_promotion"
		)
		and bool(emitted_state.call(
			"has_pending_bounded_history_promotion"
		))
		and emitted_state.has_method("get_bounded_history_transition")
	)
	if had_pending_promotion:
		pending_transition = emitted_state.call(
			"get_bounded_history_transition"
		) as Dictionary
	authoring_state_changed.emit(emitted_state)
	if not had_pending_promotion:
		return
	if (
		emitted_state == null
		or not is_instance_valid(emitted_state)
		or active_authoring_state != emitted_state
		or not emitted_state.has_method(
			"has_pending_bounded_history_promotion"
		)
		or not emitted_state.has_method(
			"reject_bounded_history_transition"
		)
	):
		return
	var appended_body_id := StringName(pending_transition.get(
		"appended_body_id",
		StringName()
	))
	if not bool(emitted_state.call(
		"has_pending_bounded_history_promotion"
	)):
		_requeue_rolled_back_promotion_body(
			emitted_state,
			appended_body_id
		)
		return
	_schedule_bounded_promotion_ack_guard(
		emitted_state,
		int(pending_transition.get("revision", -1)),
		appended_body_id
	)


func _schedule_bounded_promotion_ack_guard(
	authoring_state: Resource,
	transition_revision: int,
	appended_body_id: StringName
) -> void:
	if authoring_state == null or transition_revision < 0:
		return
	var authoring_state_instance_id := int(authoring_state.get_instance_id())
	if (
		_bounded_promotion_ack_guard_revision == transition_revision
		and _bounded_promotion_ack_guard_state_instance_id
		== authoring_state_instance_id
	):
		return
	_bounded_promotion_ack_guard_generation += 1
	_bounded_promotion_ack_guard_revision = transition_revision
	_bounded_promotion_ack_guard_state_instance_id = authoring_state_instance_id
	_guard_bounded_promotion_ack_after_grace(
		authoring_state,
		authoring_state_instance_id,
		transition_revision,
		appended_body_id,
		_bounded_promotion_ack_guard_generation
	)


func _guard_bounded_promotion_ack_after_grace(
	authoring_state: Resource,
	authoring_state_instance_id: int,
	transition_revision: int,
	appended_body_id: StringName,
	guard_generation: int
) -> void:
	var audited_idle_frames := 0
	while audited_idle_frames < BOUNDED_PROMOTION_ACK_GRACE_PROCESS_FRAMES:
		await get_tree().process_frame
		if guard_generation != _bounded_promotion_ack_guard_generation:
			return
		if (
			authoring_state == null
			or not is_instance_valid(authoring_state)
			or int(authoring_state.get_instance_id())
			!= authoring_state_instance_id
			or active_authoring_state != authoring_state
		):
			return
		if not bool(authoring_state.call(
			"has_pending_bounded_history_promotion"
		)):
			_requeue_rolled_back_promotion_body(
				authoring_state,
				appended_body_id
			)
			if _bounded_promotion_ack_guard_revision == transition_revision:
				_bounded_promotion_ack_guard_revision = -1
				_bounded_promotion_ack_guard_state_instance_id = 0
			return
		# The presenter deliberately pauses static publication while another
		# stroke is actively being drawn.  Do not consume the failure grace
		# window until that stroke releases and static synchronization can run.
		if active_placement_body_id != StringName():
			continue
		audited_idle_frames += 1
	var transition := authoring_state.call(
		"get_bounded_history_transition"
	) as Dictionary
	if int(transition.get("revision", -1)) != transition_revision:
		return
	var rejected := bool(authoring_state.call(
		"reject_bounded_history_transition",
		transition_revision,
		&"native_promotion_was_not_acknowledged"
	))
	if _bounded_promotion_ack_guard_revision == transition_revision:
		_bounded_promotion_ack_guard_revision = -1
		_bounded_promotion_ack_guard_state_instance_id = 0
	if rejected:
		_requeue_rolled_back_promotion_body(
			authoring_state,
			appended_body_id
		)
		authoring_state_changed.emit(authoring_state)


func _requeue_rolled_back_promotion_body(
	authoring_state: Resource,
	body_id: StringName
) -> void:
	if (
		authoring_state == null
		or body_id == StringName()
		or not authoring_state.has_method("is_material_body_commit_ready")
		or not bool(authoring_state.call(
			"is_material_body_commit_ready",
			body_id
		))
	):
		return
	_restore_rolled_back_action_reservation(authoring_state, body_id)
	_enqueue_deferred_material_body_commit(
		authoring_state,
		body_id,
		true
	)


func _restore_rolled_back_action_reservation(
	authoring_state: Resource,
	body_id: StringName
) -> bool:
	var bundle := authoring_state.call(
		"capture_pending_body_bundle",
		body_id
	) as Dictionary
	if not bool(bundle.get("ok", false)):
		return false
	var undo_records := _action_history.call("get_undo_records") as Array[Dictionary]
	for record_index in range(undo_records.size() - 1, -1, -1):
		var record := undo_records[record_index] as Dictionary
		if StringName(record.get("kind", StringName())) != ACTION_KIND_MATERIAL_LAYER:
			continue
		var payload := record.get("payload", {}) as Dictionary
		var action_body_ids := _get_action_record_body_ids(record)
		if action_body_ids.size() != 1 or action_body_ids[0] != body_id:
			continue
		return bool(_action_history.call(
			"replace_undo_record_at",
			record_index,
			{
				"kind": ACTION_KIND_PENDING_BODY,
				"label": String(record.get("label", "Material Stroke")),
				"payload": {
					"bundle": bundle,
					"action_body_ids": action_body_ids,
					"before_transient": payload.get(
						"before_transient",
						{}
					) as Dictionary,
					"after_transient": payload.get(
						"after_transient",
						_capture_editor_transient_snapshot()
					) as Dictionary,
				},
			}
		))
	return false

